# Claude API キー（要約に使う）。https://console.anthropic.com/settings/keys で発行する。
# ローカルでは .env に置く（.env は .gitignore 済み）。
# GitHub Actions では リポジトリ Settings > Secrets and variables > Actions に
# ANTHROPIC_API_KEY という名前で登録する。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 以下は任意。未設定なら括弧内の既定値で動く ---

# 収集対象にする時間の幅（36）
# WINDOW_HOURS=36

# 1日に掲載する最大件数（30）
# MAX_ARTICLES=30

# GitHub Pages のプロジェクトサイトに置くときのパス。
# https://<owner>.github.io/ai-news-digest/ なら /ai-news-digest
# ローカル開発では設定しない（空のまま）。
# NEXT_PUBLIC_BASE_PATH=/ai-news-digest
